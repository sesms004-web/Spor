//@version=6
indicator("Apocalypse v12 - Minor Structure Fixed", overlay=true, max_lines_count=500)

// ============================================================
// INPUTS
// ============================================================
showMinor = input.bool(true,  "Show Minor Structure", group="Display")
minorColor = input.color(color.new(#2962FF, 0), "Minor Structure Color", group="Colors")

// ============================================================
// CANDLE MATH ENGINE (Corrected Minor Logic)
// ============================================================
var int    min_tr = 1       // 1: Tracking High, -1: Tracking Low
var float  min_h = na       // Current tracked high
var int    min_h_i = na     // Bar index of tracked high
var float  min_l = na       // Current tracked low
var int    min_l_i = na     // Bar index of tracked low

var float  trig_h = na      // Trigger high to confirm a Low Pivot (High of the candle that made the low)
var float  trig_l = na      // Trigger low to confirm a High Pivot (Low of the candle that made the high)

var int    lp_i = na        // Last pivot bar index (where the next line starts)
var float  lp_p = na        // Last pivot price

var bool   initialized = false

// Inside Candle Skip Rule
isInside = (high <= high[1]) and (low >= low[1])

if barstate.isfirst and not initialized
    min_tr := close > open ? 1 : -1
    min_h := high
    min_h_i := bar_index
    trig_l := low
    min_l := low
    min_l_i := bar_index
    trig_h := high
    lp_i := bar_index
    lp_p := close
    initialized := true

if not isInside and initialized
    if min_tr == 1
        // TRACKING UP: Looking for a new high
        old_trig_l = trig_l
        if high > min_h
            min_h := high
            min_h_i := bar_index
            trig_l := low  // The low of the candle making the new high becomes the trigger
        // If price drops below the trigger low, a valid HIGH PIVOT is formed
        if low < old_trig_l
            if showMinor
                line.new(lp_i, lp_p, min_h_i, min_h, color=minorColor, width=2, style=line.style_solid)
            // Switch direction to tracking low
            min_tr := -1
            lp_i := min_h_i
            lp_p := min_h
            min_l := low
            min_l_i := bar_index
            trig_h := high
    else
        // TRACKING DOWN: Looking for a new low
        old_trig_h = trig_h
        if low < min_l
            min_l := low
            min_l_i := bar_index
            trig_h := high // The high of the candle making the new low becomes the trigger
        // If price breaks above the trigger high, a valid LOW PIVOT is formed
        if high > old_trig_h
            if showMinor
                line.new(lp_i, lp_p, min_l_i, min_l, color=minorColor, width=2, style=line.style_solid)
            // Switch direction to tracking high
            min_tr := 1
            lp_i := min_l_i
            lp_p := min_l
            min_h := high
            min_h_i := bar_index
            trig_l := low
