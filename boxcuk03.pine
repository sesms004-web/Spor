//@version=5
indicator("SMACv2 CHoCH Box - TV Port", overlay=true, max_boxes_count=500, max_lines_count=500)

// --- INPUTS ---
show_min = input.bool(true, "Show Minor Swings")
show_maj = input.bool(true, "Show Major Swings")
show_vl = input.bool(true, "Show Vertical Lines")
show_box = input.bool(true, "Show Boxes")
// Colors
color_min = input.color(color.silver, "Minor Color")
color_bull = input.color(color.lime, "Bull Major Color")
color_bear = input.color(color.red, "Bear Major Color")
color_vl_bull = input.color(color.blue, "Bull VL Color")
color_vl_bear = input.color(color.maroon, "Bear VL Color")
color_box_bull = input.color(color.new(color.blue, 70), "Bull Box")
color_box_bear = input.color(color.new(color.red, 70), "Bear Box")
color_box_bull_faint = input.color(color.new(color.blue, 90), "Bull Box Faint")
color_box_bear_faint = input.color(color.new(color.red, 90), "Bear Box Faint")

max_box_pct = input.float(20.0, "Max Box %")
weak_zone_pct = input.float(50.0, "Weak Zone %")

// --- PRIMITIVE STATE (Auto-rollbacks on unconfirmed ticks) ---
var int min_tr = 0
var int maj_tr = 0
var int maj_st = 0
var float min_h = 0.0
var int min_h_i = 0
var float min_l = 0.0
var int min_l_i = 0
var float trig_h = 0.0
var float trig_l = 0.0
var int lp_i = 0
var float lp_p = 0.0
var float maj_h = 0.0
var float maj_l = 0.0
var int maj_h_i = 0
var int maj_l_i = 0
var float tmp_h = 0.0
var int tmp_h_i = 0
var float tmp_l = 0.0
var int tmp_l_i = 0
var int anc_i = 0
var float anc_v = 0.0
var int bos_i = 0
var float mb_h = 0.0
var float mb_l = 0.0
var int mb_i = 0
var int bx_phase = 0
var bool bx_extreme = false
var float bx_swing_h = 0.0
var float bx_swing_l = 0.0
var bool has_pot_bull_minor = false
var int pot_bull_start_i = 0
var float pot_bull_start_p = 0.0
var float pot_bull_end_p = 0.0
var bool has_pot_bear_minor = false
var int pot_bear_start_i = 0
var float pot_bear_start_p = 0.0
var float pot_bear_end_p = 0.0

var line cur_top_line = na
var line cur_bot_line = na

// Stack arrays do not rollback automatically, we must manage them!
var array<float> st_h_vals = array.new<float>()
var array<int> st_h_idxs = array.new<int>()
var array<float> st_l_vals = array.new<float>()
var array<int> st_l_idxs = array.new<int>()

// Active Boxes array for BxAdvanceTrim
var array<box> active_boxes = array.new<box>()

// Copy logic to rollback arrays mid-bar
var array<float> saved_st_h_vals = array.new<float>()
var array<int> saved_st_h_idxs = array.new<int>()
var array<float> saved_st_l_vals = array.new<float>()
var array<int> saved_st_l_idxs = array.new<int>()
var array<box> saved_active_boxes = array.new<box>()

if barstate.isnew
    // Save state at start of bar
    saved_st_h_vals := array.copy(st_h_vals)
    saved_st_h_idxs := array.copy(st_h_idxs)
    saved_st_l_vals := array.copy(st_l_vals)
    saved_st_l_idxs := array.copy(st_l_idxs)
    saved_active_boxes := array.copy(active_boxes)
else
    // Rollback mid-bar
    st_h_vals := array.copy(saved_st_h_vals)
    st_h_idxs := array.copy(saved_st_h_idxs)
    st_l_vals := array.copy(saved_st_l_vals)
    st_l_idxs := array.copy(saved_st_l_idxs)
    active_boxes := array.copy(saved_active_boxes)

// Stack helpers
push_h(val, idx) =>
    array.push(st_h_vals, val)
    array.push(st_h_idxs, idx)

push_l(val, idx) =>
    array.push(st_l_vals, val)
    array.push(st_l_idxs, idx)

pop_h() =>
    if array.size(st_h_vals) > 0
        array.pop(st_h_vals)
        array.pop(st_h_idxs)

pop_l() =>
    if array.size(st_l_vals) > 0
        array.pop(st_l_vals)
        array.pop(st_l_idxs)

clear_h() =>
    array.clear(st_h_vals)
    array.clear(st_h_idxs)

clear_l() =>
    array.clear(st_l_vals)
    array.clear(st_l_idxs)

// Reset helper
BxReset(rl, rh) =>
    bx_phase := 0
    bx_extreme := false
    bx_swing_l := rl
    bx_swing_h := rh

// Trim active boxes
BxAdvanceTrim(t_index) =>
    if array.size(active_boxes) > 0
        for i = array.size(active_boxes) - 1 to 0 by -1
            b = array.get(active_boxes, i)
            // End the box extension
            box.set_extend(b, extend.none)
            box.set_right(b, t_index)
            array.remove(active_boxes, i)

// Draw Box
DoDrawBox(left_i, top, bot, clr) =>
    if show_box
        l_i = left_i < anc_i ? anc_i : left_i
        t = top
        b = bot
        if t < b
            tmp = t
            t := b
            b := tmp

        maj_sz = maj_h - maj_l
        if maj_sz > 0 and (t - b) / maj_sz * 100.0 > max_box_pct
            if clr == color_box_bull or clr == color_box_bull_faint
                fh = -1.0
                fi = l_i
                if array.size(st_h_vals) > 0
                    for k = 0 to array.size(st_h_vals) - 1
                        mh = array.get(st_h_vals, k)
                        if mh > b and mh < t and (fh < 0 or mh < fh)
                            fh := mh
                            fi := array.get(st_h_idxs, k)
                if fh > 0
                    t := fh
                    l_i := fi
                else
                    t := b + maj_sz * max_box_pct / 100.0
            else
                fl = -1.0
                fi = l_i
                if array.size(st_l_vals) > 0
                    for k = 0 to array.size(st_l_vals) - 1
                        ml = array.get(st_l_vals, k)
                        if ml < t and ml > b and (fl < 0 or ml > fl)
                            fl := ml
                            fi := array.get(st_l_idxs, k)
                if fl > 0
                    b := fl
                    l_i := fi
                else
                    b := t - maj_sz * max_box_pct / 100.0
        if t > b
            // Draw box and extend right, save to active boxes
            bx = box.new(l_i, t, bar_index, b, border_color=clr, bgcolor=color.new(clr, 85), extend=extend.right)
            array.push(active_boxes, bx)

CutLine(l, t_idx) =>
    if not na(l)
        line.set_x2(l, t_idx)
        line.set_extend(l, extend.none)

UpdateLevel(l, v) =>
    if not na(l)
        line.set_y1(l, v)
        line.set_y2(l, v)

// Initialization at bar 0
if bar_index == 0
    min_tr := close > open ? 1 : -1
    maj_tr := min_tr
    maj_st := 1
    maj_h := high + (high - low) * 0.1
    maj_l := low - (high - low) * 0.1
    BxReset(low, high)
    min_h := high
    min_h_i := bar_index
    min_l := low
    min_l_i := bar_index
    trig_h := high
    trig_l := low
    lp_i := bar_index
    lp_p := close
    tmp_h := high
    tmp_h_i := bar_index
    tmp_l := low
    tmp_l_i := bar_index
    anc_i := bar_index
    anc_v := close
    mb_h := high
    mb_l := low
    mb_i := bar_index
    bos_i := bar_index
    maj_h_i := bar_index
    maj_l_i := bar_index

// Logic inside bar processing
inside = high <= mb_h and low >= mb_l
if not inside
    if high > mb_h or low < mb_l
        mb_h := high
        mb_l := low
        mb_i := bar_index

    // ProcessBar
    val_h = high
    val_l = low
    val_c = close

    // MINOR
    ot = 0.0
    if min_tr == 1
        ot := trig_l
        if val_h > min_h
            min_h := val_h
            min_h_i := bar_index
            trig_l := val_l
        if val_l < ot
            pi = min_h_i
            pp = min_h
            si = lp_i
            sp = lp_p
            if show_min
                line.new(si, sp, pi, pp, color=color_min, width=1)
            if maj_tr == -1 and not has_pot_bull_minor and si >= tmp_l_i
                has_pot_bull_minor := true
                pot_bull_start_i := si
                pot_bull_start_p := sp
                pot_bull_end_p := pp
            if maj_st == 0 and maj_tr == 1
                if bx_phase == 0 or bx_phase == 2
                    DoDrawBox(si, pp, sp, color_box_bull)
                    bx_phase := 1
                    bx_extreme := false
                    bx_swing_h := pp
                    bx_swing_l := sp
                else
                    if pp > bx_swing_h
                        bx_extreme := true
                        bx_swing_h := pp
            if maj_st == 0 and maj_tr == -1 and bx_phase == 1
                if bx_extreme and pp > bx_swing_h
                    bx_phase := 2
                    bx_extreme := false
                else
                    bx_swing_h := pp
            push_h(pp, pi)
            if maj_tr == 1 and maj_st == 0 and pp < tmp_h and array.size(st_l_vals) > 0
                if array.get(st_l_idxs, array.size(st_l_idxs) - 1) > bos_i
                    pop_l()
            min_tr := -1
            lp_i := pi
            lp_p := pp
            min_l := val_l
            min_l_i := bar_index
            trig_h := val_h
    else
        ot := trig_h
        if val_l < min_l
            min_l := val_l
            min_l_i := bar_index
            trig_h := val_h
        if val_h > ot
            ti = min_l_i
            tp = min_l
            si = lp_i
            sp = lp_p
            if show_min
                line.new(si, sp, ti, tp, color=color_min, width=1)
            if maj_tr == 1 and not has_pot_bear_minor and si >= tmp_h_i
                has_pot_bear_minor := true
                pot_bear_start_i := si
                pot_bear_start_p := sp
                pot_bear_end_p := tp
            if maj_st == 0 and maj_tr == 1 and bx_phase == 1
                if bx_extreme and tp < bx_swing_l
                    bx_phase := 2
                    bx_extreme := false
                else
                    bx_swing_l := tp
            if maj_st == 0 and maj_tr == -1
                if bx_phase == 0 or bx_phase == 2
                    DoDrawBox(si, sp, tp, color_box_bear)
                    bx_phase := 1
                    bx_extreme := false
                    bx_swing_h := sp
                    bx_swing_l := tp
                else
                    if tp < bx_swing_l
                        bx_extreme := true
                        bx_swing_l := tp
            push_l(tp, ti)
            if maj_tr == -1 and maj_st == 0 and tp > tmp_l and array.size(st_h_vals) > 0
                if array.get(st_h_idxs, array.size(st_h_idxs) - 1) > bos_i
                    pop_h()
            min_tr := 1
            lp_i := ti
            lp_p := tp
            min_h := val_h
            min_h_i := bar_index
            trig_l := val_l

    // MAJOR
    if maj_tr == 0
        maj_tr := 1
        anc_i := min_l_i
        anc_v := min_l
        maj_l_i := min_l_i

    if maj_tr == 1
        if val_h > tmp_h
            tmp_h := val_h
            tmp_h_i := bar_index
            has_pot_bear_minor := false
        if maj_st == 0
            act = array.size(st_l_vals) > 0 ? array.get(st_l_vals, array.size(st_l_vals) - 1) : na
            if not na(act) and val_l < act
                maj_h := tmp_h
                maj_h_i := tmp_h_i
                if show_maj
                    line.new(anc_i, anc_v, maj_h_i, maj_h, color=color_bull, width=2)
                if show_vl
                    line.new(anc_i, low, anc_i, high, color=color_vl_bull, extend=extend.both, style=line.style_dashed)
                    line.new(maj_h_i, low, maj_h_i, high, color=color_vl_bull, extend=extend.both, style=line.style_dashed)
                BxAdvanceTrim(maj_h_i)
                clear_l()
                clear_h()
                maj_st := 1
                anc_i := maj_h_i
                anc_v := maj_h
                tmp_l := val_l
                tmp_l_i := bar_index
                CutLine(cur_top_line, bar_index)
                CutLine(cur_bot_line, bar_index)
                if show_maj
                    cur_top_line := line.new(maj_h_i, maj_h, bar_index + 1, maj_h, color=color_bull, style=line.style_dashed, extend=extend.right)
                    if not na(maj_l) and maj_l != 0
                        cur_bot_line := line.new(maj_l_i, maj_l, bar_index + 1, maj_l, color=color_bull, style=line.style_dashed, extend=extend.right)
        if not na(maj_l) and maj_l != 0 and val_l < maj_l and val_c >= maj_l
            maj_l := val_l
            if show_maj
                UpdateLevel(cur_bot_line, maj_l)
        if not na(maj_l) and maj_l != 0 and val_c < maj_l
            BxAdvanceTrim(tmp_h_i)
            maj_tr := -1
            maj_st := 0
            bos_i := bar_index
            if show_maj
                line.new(anc_i, anc_v, tmp_h_i, tmp_h, color=color_bull, width=2)
            if show_vl
                line.new(anc_i, low, anc_i, high, color=color_vl_bull, extend=extend.both, style=line.style_dashed)
                line.new(tmp_h_i, low, tmp_h_i, high, color=color_vl_bull, extend=extend.both, style=line.style_dashed)
            clear_l()
            anc_i := tmp_h_i
            anc_v := tmp_h
            tmp_l := val_l
            tmp_l_i := bar_index
            maj_h := tmp_h
            maj_h_i := tmp_h_i
            maj_l := val_l
            maj_l_i := bar_index
            if has_pot_bear_minor
                DoDrawBox(pot_bear_start_i, pot_bear_start_p, pot_bear_end_p, color_box_bear_faint)
            BxReset(val_l, tmp_h)
            CutLine(cur_top_line, bar_index)
            CutLine(cur_bot_line, bar_index)
            cur_top_line := na
            cur_bot_line := na
    else if maj_st == 1
        if val_l < tmp_l
            tmp_l := val_l
            tmp_l_i := bar_index
            has_pot_bull_minor := false
        if val_h > maj_h and val_c <= maj_h
            maj_h := val_h
            if show_maj
                UpdateLevel(cur_top_line, maj_h)
        if val_c > maj_h
            bos_i := bar_index
            maj_l := tmp_l
            maj_l_i := tmp_l_i
            if show_maj
                line.new(anc_i, anc_v, maj_l_i, maj_l, color=color_bull, width=2)
            clear_h()
            maj_st := 0
            anc_i := maj_l_i
            anc_v := maj_l
            tmp_h := val_h
            tmp_h_i := bar_index
            BxReset(maj_l, val_h)
            CutLine(cur_top_line, bar_index)
            CutLine(cur_bot_line, bar_index)
            cur_top_line := na
            cur_bot_line := na
        if not na(maj_l) and maj_l != 0 and val_l < maj_l and val_c >= maj_l
            maj_l := val_l
            if show_maj
                UpdateLevel(cur_bot_line, maj_l)
        if not na(maj_l) and maj_l != 0 and val_c < maj_l
            BxAdvanceTrim(tmp_h_i)
            maj_tr := -1
            maj_st := 0
            bos_i := bar_index
            if show_maj
                line.new(anc_i, anc_v, tmp_h_i, tmp_h, color=color_bull, width=2)
            if show_vl
                line.new(anc_i, low, anc_i, high, color=color_vl_bull, extend=extend.both, style=line.style_dashed)
                line.new(tmp_h_i, low, tmp_h_i, high, color=color_vl_bull, extend=extend.both, style=line.style_dashed)
            clear_l()
            anc_i := tmp_h_i
            anc_v := tmp_h
            tmp_l := val_l
            tmp_l_i := bar_index
            maj_h := tmp_h
            maj_h_i := tmp_h_i
            maj_l := val_l
            maj_l_i := bar_index
            if has_pot_bear_minor
                DoDrawBox(pot_bear_start_i, pot_bear_start_p, pot_bear_end_p, color_box_bear_faint)
            BxReset(val_l, tmp_h)
            CutLine(cur_top_line, bar_index)
            CutLine(cur_bot_line, bar_index)
            cur_top_line := na
            cur_bot_line := na
    else
        if val_l < tmp_l
            tmp_l := val_l
            tmp_l_i := bar_index
            has_pot_bull_minor := false
        if maj_st == 0
            act = array.size(st_h_vals) > 0 ? array.get(st_h_vals, array.size(st_h_vals) - 1) : na
            if not na(act) and val_h > act
                maj_l := tmp_l
                maj_l_i := tmp_l_i
                if show_maj
                    line.new(anc_i, anc_v, maj_l_i, maj_l, color=color_bear, width=2)
                if show_vl
                    line.new(anc_i, low, anc_i, high, color=color_vl_bear, extend=extend.both, style=line.style_dashed)
                    line.new(maj_l_i, low, maj_l_i, high, color=color_vl_bear, extend=extend.both, style=line.style_dashed)
                BxAdvanceTrim(maj_l_i)
                clear_l()
                clear_h()
                maj_st := 1
                anc_i := maj_l_i
                anc_v := maj_l
                tmp_h := val_h
                tmp_h_i := bar_index
                CutLine(cur_top_line, bar_index)
                CutLine(cur_bot_line, bar_index)
                if show_maj
                    cur_bot_line := line.new(maj_l_i, maj_l, bar_index + 1, maj_l, color=color_bear, style=line.style_dashed, extend=extend.right)
                    if not na(maj_h) and maj_h != 0
                        cur_top_line := line.new(maj_h_i, maj_h, bar_index + 1, maj_h, color=color_bear, style=line.style_dashed, extend=extend.right)
        if not na(maj_h) and maj_h != 0 and val_h > maj_h and val_c <= maj_h
            maj_h := val_h
            if show_maj
                UpdateLevel(cur_top_line, maj_h)
        if not na(maj_h) and maj_h != 0 and val_c > maj_h
            BxAdvanceTrim(tmp_l_i)
            maj_tr := 1
            maj_st := 0
            bos_i := bar_index
            if show_maj
                line.new(anc_i, anc_v, tmp_l_i, tmp_l, color=color_bear, width=2)
            if show_vl
                line.new(anc_i, low, anc_i, high, color=color_vl_bear, extend=extend.both, style=line.style_dashed)
                line.new(tmp_l_i, low, tmp_l_i, high, color=color_vl_bear, extend=extend.both, style=line.style_dashed)
            clear_h()
            anc_i := tmp_l_i
            anc_v := tmp_l
            tmp_h := val_h
            tmp_h_i := bar_index
            maj_l := tmp_l
            maj_l_i := tmp_l_i
            maj_h := val_h
            maj_h_i := bar_index
            if has_pot_bull_minor
                DoDrawBox(pot_bull_start_i, pot_bull_end_p, pot_bull_start_p, color_box_bull_faint)
            BxReset(tmp_l, val_h)
            CutLine(cur_top_line, bar_index)
            CutLine(cur_bot_line, bar_index)
            cur_top_line := na
            cur_bot_line := na
    else if maj_st == 1
        if val_h > tmp_h
            tmp_h := val_h
            tmp_h_i := bar_index
            has_pot_bear_minor := false
        if val_l < maj_l and val_c >= maj_l
            maj_l := val_l
            if show_maj
                UpdateLevel(cur_bot_line, maj_l)
        if val_c < maj_l
            maj_h := tmp_h
            bos_i := bar_index
            maj_h_i := tmp_h_i
            if show_maj
                line.new(anc_i, anc_v, maj_h_i, maj_h, color=color_bear, width=2)
            clear_l()
            maj_st := 0
            anc_i := maj_h_i
            anc_v := maj_h
            tmp_l := val_l
            tmp_l_i := bar_index
            BxReset(val_l, maj_h)
            CutLine(cur_top_line, bar_index)
            CutLine(cur_bot_line, bar_index)
            cur_top_line := na
            cur_bot_line := na
        if not na(maj_h) and maj_h != 0 and val_h > maj_h and val_c <= maj_h
            maj_h := val_h
            if show_maj
                UpdateLevel(cur_top_line, maj_h)
        if not na(maj_h) and maj_h != 0 and val_c > maj_h
            BxAdvanceTrim(tmp_l_i)
            maj_tr := 1
            maj_st := 0
            bos_i := bar_index
            if show_maj
                line.new(anc_i, anc_v, tmp_l_i, tmp_l, color=color_bear, width=2)
            if show_vl
                line.new(anc_i, low, anc_i, high, color=color_vl_bear, extend=extend.both, style=line.style_dashed)
                line.new(tmp_l_i, low, tmp_l_i, high, color=color_vl_bear, extend=extend.both, style=line.style_dashed)
            clear_h()
            anc_i := tmp_l_i
            anc_v := tmp_l
            tmp_h := val_h
            tmp_h_i := bar_index
            maj_l := tmp_l
            maj_l_i := tmp_l_i
            maj_h := val_h
            maj_h_i := bar_index
            if has_pot_bull_minor
                DoDrawBox(pot_bull_start_i, pot_bull_end_p, pot_bull_start_p, color_box_bull_faint)
            BxReset(tmp_l, val_h)
            CutLine(cur_top_line, bar_index)
            CutLine(cur_bot_line, bar_index)
            cur_top_line := na
            cur_bot_line := na

// --- DASHBOARD & NOTIFICATIONS ---
show_dashboard = input.bool(true, "Show Dashboard")
dashboard_pos = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"])

table_pos = dashboard_pos == "Top Right" ? position.top_right : dashboard_pos == "Top Left" ? position.top_left : dashboard_pos == "Bottom Right" ? position.bottom_right : position.bottom_left

var table info_table = table.new(table_pos, 3, 5, border_width=1)

m1_close = request.security(syminfo.tickerid, "1", close)
m1_close9 = request.security(syminfo.tickerid, "1", close[9])
m5_close = request.security(syminfo.tickerid, "5", close)
m5_close9 = request.security(syminfo.tickerid, "5", close[9])
m15_close = request.security(syminfo.tickerid, "15", close)
m15_close9 = request.security(syminfo.tickerid, "15", close[9])

if show_dashboard
    table.cell(info_table, 0, 0, "Timeframe", text_color=color.white, bgcolor=color.black)
    table.cell(info_table, 1, 0, "Trend", text_color=color.white, bgcolor=color.black)
    table.cell(info_table, 2, 0, "Signal", text_color=color.white, bgcolor=color.black)

    table.cell(info_table, 0, 1, "M1", text_color=color.white, bgcolor=color.blue)
    table.cell(info_table, 1, 1, m1_close > m1_close9 ? "UP" : "DOWN", text_color=m1_close > m1_close9 ? color.lime : color.red)

    table.cell(info_table, 0, 2, "M5", text_color=color.white, bgcolor=color.blue)
    table.cell(info_table, 1, 2, m5_close > m5_close9 ? "UP" : "DOWN", text_color=m5_close > m5_close9 ? color.lime : color.red)

    table.cell(info_table, 0, 3, "M15", text_color=color.white, bgcolor=color.blue)
    table.cell(info_table, 1, 3, m15_close > m15_close9 ? "UP" : "DOWN", text_color=m15_close > m15_close9 ? color.lime : color.red)

// --- ALERTS ---
bool choch_bull = maj_tr == 1 and maj_tr[1] == -1
bool choch_bear = maj_tr == -1 and maj_tr[1] == 1

if choch_bull
    alert("Bullish CHoCH on " + syminfo.tickerid + " timeframe " + timeframe.period, alert.freq_once_per_bar_close)

if choch_bear
    alert("Bearish CHoCH on " + syminfo.tickerid + " timeframe " + timeframe.period, alert.freq_once_per_bar_close)

alertcondition(choch_bull, title="Bullish CHoCH", message="Bullish CHoCH Deteced")
alertcondition(choch_bear, title="Bearish CHoCH", message="Bearish CHoCH Deteced")
